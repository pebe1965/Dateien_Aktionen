# KI-Provider Auswahl: 'app' (empfohlen), 'gemini', 'local' oder 'offline'
AI_PROVIDER=app

# KI über NotionaryAtlas: Zugangscode im Marketplace der App erstellen
# (https://app.pberthold.com/marketplace → Dateien_Aktionen → „Zugangscode erstellen“)
NOTIONARY_ZUGANGSCODE=

# Optional: eigener Google-Gemini-Schlüssel (nur mit AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Lokale KI Konfiguration (z.B. MLX, LM Studio oder Ollama)
LOCAL_API_URL=http://localhost:1234/v1/chat/completions
LOCAL_MODEL=local-model
