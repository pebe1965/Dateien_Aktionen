# KI-Provider Auswahl: 'gemini', 'local' oder 'offline'
AI_PROVIDER=gemini

# Google Gemini API Konfiguration
GEMINI_API_KEY=DEIN_GEMINI_API_KEY_HIER
GEMINI_MODEL=gemini-2.5-flash  # Oder gemini-3.7-flash, gemini-3.8-flash, etc.

# Lokale KI Konfiguration (z.B. MLX, LM Studio oder Ollama)
LOCAL_API_URL=http://localhost:1234/v1/chat/completions
LOCAL_MODEL=local-model
